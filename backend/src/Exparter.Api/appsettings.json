{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "exparter",
    "Audience": "exparter-clients"
  },
  "Email": {
    "FromAddress": "no-reply@exparter.local",
    "FromName": "Exparter"
  },
  "Sentry": {
    "Dsn": ""
  },
  "Storage": {
    "Region": "garage",
    "Bucket": "exparter"
  },
  "AllowedHosts": "*"
}
