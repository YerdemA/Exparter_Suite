# Copy this file to .env and adjust the values. The real .env is never committed.

POSTGRES_USER=exparter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=exparter

# Host port for PostgreSQL. Change it if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# Mailpit catches development emails. Open the UI at http://localhost:8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Garage (S3-compatible object storage). Generate your own values:
#   GARAGE_RPC_SECRET:  openssl rand -hex 32
#   STORAGE_ACCESS_KEY: "GK" followed by: openssl rand -hex 12
#   STORAGE_SECRET_KEY: openssl rand -hex 32
GARAGE_RPC_SECRET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=exparter
STORAGE_PORT=3900

# LiveKit (video calls, see ADR 0015). The API key is any name; generate the secret:
#   LIVEKIT_API_SECRET: openssl rand -hex 32
# Give the API the same pair: user-secrets LiveKit:ApiKey and LiveKit:ApiSecret.
# LIVEKIT_NODE_IP is the address the server tells clients to send media to; 10.0.2.2
# is the host as seen from the Android emulator.
LIVEKIT_API_KEY=exparter-dev
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=10.0.2.2
