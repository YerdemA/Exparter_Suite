# Copy this file to .env and adjust the values. The real .env is never committed.

POSTGRES_USER=exparter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=exparter

# Host port for PostgreSQL. Change it if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# Mailpit catches development emails. Open the UI at http://localhost:8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
