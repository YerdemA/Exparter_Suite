# Copy to .env on the server and fill in. The real .env never enters the repository.

# The image the deployment workflow publishes (lowercase owner name).
API_IMAGE=ghcr.io/yerdema/exparter-api:latest

# Host names; their DNS A records point at the server (docs/deployment.md).
API_HOST=api.example.com
SITE_HOST=example.com

POSTGRES_USER=exparter
POSTGRES_DB=exparter
# openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters: openssl rand -base64 48
JWT_SIGNING_KEY=

# Brevo SMTP (Settings > SMTP & API).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@example.com

# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com and an API token's S3 keys.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=exparter
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Video calls (ADR 0015). RTC_HOST also needs a DNS A record. The API key is any name;
# the secret: openssl rand -hex 32. LIVEKIT_NODE_IP is the server's public address,
# which clients send media to.
RTC_HOST=rtc.example.com
LIVEKIT_API_KEY=exparter
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=

# The exparter-api project's DSN in Sentry.
SENTRY_DSN=

# Off-server copies of the nightly backup (backup.sh): a second R2 bucket and an API
# token limited to it. Leave BACKUP_BUCKET empty to keep the backups on the server only.
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
