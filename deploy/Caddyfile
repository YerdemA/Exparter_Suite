# Caddy gets and renews the HTTPS certificates of both names by itself.

# Law No. 5651 asks a hosting provider to keep traffic data for a year: who reached the
# service (address and port), when, what was asked and how it ended
# (docs/legal/compliance-research.md). Headers are dropped, and the hub's access token and
# the one-time token of email links are cut from the address, so no credential lands in
# the file.
(traffic_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep -1
			roll_keep_for 8760h
		}
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
			request>uri query {
				delete access_token
				delete token
			}
		}
	}
}

# The API, and the real-time hub over WebSocket.
{$API_HOST} {
	import traffic_log
	encode zstd gzip
	reverse_proxy api:8080
}

# Public pages the store listing links to, and the pages email links open when the app is
# not installed (docs/adr/0009-email-deep-links.md).
{$SITE_HOST} {
	import traffic_log
	encode zstd gzip

	# The two calls those pages make go to the API from this origin, so the API needs no
	# CORS. The API accepts only its own host name.
	@email_links path /api/v1/auth/email-verification/confirm /api/v1/auth/password-reset/confirm
	handle @email_links {
		reverse_proxy api:8080 {
			header_up Host {$API_HOST}
		}
	}

	handle {
		root * /srv/site
		try_files {path} {path}.html
		file_server
	}
}
