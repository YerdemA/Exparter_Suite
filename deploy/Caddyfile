# Caddy gets and renews the HTTPS certificates of both names by itself.

# Law No. 5651 asks a hosting provider to keep traffic data for a year: who reached the
# service (address and port), when, what was asked and how it ended
# (docs/legal/compliance-research.md). Headers are dropped and the hub's access token is
# cut from the address, so no credential lands in the file.
(traffic_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep -1
			roll_keep_for 8760h
		}
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
			request>uri query {
				delete access_token
			}
		}
	}
}

# The API, and the real-time hub over WebSocket.
{$API_HOST} {
	import traffic_log
	encode zstd gzip
	reverse_proxy api:8080
}

# Public pages the store listing links to: the privacy policy and the data notice.
{$SITE_HOST} {
	import traffic_log
	encode zstd gzip
	root * /srv/site
	file_server
}
